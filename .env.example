# LeanLoop — environment variables reference
# In production these are set on your Cloud Run service (built into env.yaml during setup),
# NOT committed to git. This file is only a reference / for local testing.

# --- Server auth ---
MCP_SECRET=            # long random string; forms your connector URL .../<MCP_SECRET>/mcp — treat as a PASSWORD

# --- Notion (get the *_DS data-source IDs from each database; token starts ntn_) ---
NOTION_TOKEN=
NOTION_FOODLOG_DS=
NOTION_TRAININGLOG_DS=
NOTION_BODYMETRICS_DS=
NOTION_FOODLIB_DS=
NOTION_EXERCISELIB_DS=   # optional — weight-training exercise library
CONFIG_PAGE_ID=          # the Config page ID (the coach's "brain")
PROGRESS_PAGE_ID=        # parent/tracker page that shows cumulative deficit

# --- Garmin ---
GARMINTOKENS_B64=        # base64 of your Garmin token folder (from gen_token.py)
GARMIN_EMAIL=            # used for automatic token re-login
GARMIN_PASSWORD=

# --- Coaching / misc ---
PLAYBOOK_URL=            # raw GitHub URL of playbook.md (served live at runtime)
TDEE_BASELINE=           # fallback daily burn for no-watch days (BMR x activity factor, e.g. 2000)
D1_DATE=                 # program start date YYYY-MM-DD (for D[N] row titles) — optional
TZ_NAME=Asia/Bangkok     # your timezone
# PORT is set by Cloud Run automatically
